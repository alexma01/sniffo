{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sniffo",
  "version": "0.2.0",
  "identifier": "dev.sniffo.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sniffo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 26 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Alessandro Marra",
    "category": "DeveloperTool",
    "shortDescription": "Free HTTP/HTTPS debugging proxy",
    "longDescription": "Sniffo captures, inspects and rewrites HTTP, HTTPS and WebSocket traffic from your computer, simulators, emulators and phones.",
    "copyright": "\u00a9 2026 Alessandro Marra",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libnss3-tools"
        ]
      }
    }
  }
}